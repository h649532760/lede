/dts-v1/;

#include "mt7621.dtsi"
#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>

/ {
	compatible = "hailin,hl7621-s", "mediatek,mt7621-soc";
	model = "Hailin HL7621-S";

	aliases {
		led-boot = &led_power;
		led-failsafe = &led_power;
		led-running = &led_power;
		led-upgrade = &led_power;
		label-mac-device = &gmac0;
	};

	chosen {
		bootargs = "console=ttyS0,115200";
	};

	leds {
		compatible = "gpio-leds";
		led_power: power {
			label = "power";
			gpios = <&gpio 7 GPIO_ACTIVE_LOW>;
		};
	};

	keys {
		compatible = "gpio-keys";
		reset {
			label = "reset";
			gpios = <&gpio 18 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
		};
	};
};

&spi0 {
	status = "okay";

	flash@0 {
		compatible = "jedec,spi-nor";
		reg = <0x0 0x2000000>;
		spi-max-frequency = <40000000>;
		broken-flash-reset;  /* MT7621经典修复，解决reboot死循环 */

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			partition@0 {
				label = "u-boot";
				reg = <0x000000 0x050000>;
				read-only;
			};

			partition@50000 {
				label = "u-boot-env";
				reg = <0x050000 0x010000>;
			};

			factory: partition@60000 {
				label = "factory";
				reg = <0x060000 0x010000>;
				read-only; /* WiFi校准数据，禁止覆盖！ */
			};

			partition@70000 {
				label = "firmware";
				reg = <0x070000 0x1f90000>;
			};
		};
	};
};

&gmac0 {
	mtd-mac-address = <&factory 0x0004>;
};

&gmac1 {
	status = "disabled";
};

&switch0 {
	ports {
		port@0 {
			status = "okay";
			label = "wan";
		};
		port@1 {
			status = "okay";
			label = "lan1";
		};
		port@2 {
			status = "okay";
			label = "lan2";
		};
		port@3 {
			status = "okay";
			label = "lan3";
		};
		port@4 {
			status = "okay";
			label = "lan4";
		};
	};
};

&pcie0 {
	status = "okay";
};

&pcie1 {
	status = "okay";
};

&pcie2 {
	status = "okay";
};

&usb {
	status = "okay";
};

&uart0 {
	status = "okay";
};
